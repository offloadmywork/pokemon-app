{
  "name": "CaughtPokemon",
  "type": "object",
  "properties": {
    "pokemon_id": {
      "type": "string",
      "description": "Reference to the Pokemon entity"
    },
    "caught_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the Pokémon was caught"
    },
    "nickname": {
      "type": "string",
      "description": "Optional custom nickname for the caught Pokémon"
    }
  },
  "required": ["pokemon_id", "caught_date"]
}
